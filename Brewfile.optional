# Brewfile.optional - not required; each entry unlocks one feature.
#
# Nothing here is needed for the shell, git, vim, or agent configs to work. Every
# config that touches these tools is guarded or fails only at the point of use,
# so installing none of them leaves a working machine.
#
#   brew bundle --file=Brewfile.optional
# or pick individually:
#   brew install rclone

# Terminal UI for inspecting and operating Kubernetes clusters.
brew "k9s"

# Unlocks the `onedrive` alias in zshrc (rclone --vfs-cache-mode writes mount
# onedrive: ~/OneDrive). Also needs an `onedrive` remote configured with
# `rclone config`; the alias is a command-not-found without the binary.
brew "rclone"

# Download defaults live in config/yt-dlp/config.
brew "yt-dlp"

# yt-dlp needs ffmpeg for merging and embedding. Node.js is managed separately
# by the machine's runtime manager.
brew "ffmpeg"

# Backs vimrc's markdown <PageDown><PageDown> mapping
# (pandoc -f markdown -t latex -s -o %.pdf). Without it that mapping is a
# command-not-found; note it also needs a LaTeX engine to reach PDF, which no
# entry here provides - see the tectonic note below.
brew "pandoc"

# Unlocks config/gnupg/common.conf (use-keyboxd) and the `symcrypt` alias
# (gpg -c --no-symkey-cache) for symmetric file encryption.
brew "gnupg"

# Unlocks a fast, self-contained LaTeX build with no TeX Live install. Whether it
# is present is machine state: record it in ~/.agents/AGENTS.local.md, never in
# the tracked agents/AGENTS.md, so agents on a fresh machine do not assume a TeX
# engine that is not there. Note vimrc's tex <PageDown><PageDown> mapping calls
# xelatex, which tectonic does not provide.
brew "tectonic"

# The two GUI apps whose configs this repo does install: config/ghostty/config.ghostty
# (append-once into ~/.config/ghostty/config) and config/vscode/settings.json
# (jq-merged into VS Code's User settings). Extras rather than requirements
# because both installs are inert when the app is absent - the file is simply
# never read - and neither app is on the path of any shell, git or agent config.
cask "ghostty"
cask "visual-studio-code"
