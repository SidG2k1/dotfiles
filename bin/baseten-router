#!/bin/sh
set -eu

fail() { printf 'baseten-router: %s\n' "$*" >&2; exit 1; }

[ "$#" -le 1 ] || fail "usage: baseten-router [--setup|--help]"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/baseten-router"
ROUTER="$CONFIG_DIR/router.py"

case "${1:-}" in
  --setup)
    command -v uv >/dev/null 2>&1 || fail "uv is required; install it first."
    [ -r "$ROUTER" ] || fail "Router code is missing. Run install.sh install router from your dotfiles checkout."
    exec uv run --python 3.12 --script "$ROUTER" --setup
    ;;
  -h|--help)
    cat <<'EOF'
Usage: baseten-router [--setup|--help]

--setup resolves the router's Python runtime, then exits without starting it.
Set BASETEN_API_KEY, or set BASETEN_OP_ITEM in
~/.config/baseten-router/env to read the password field of a 1Password item.
XDG_CONFIG_HOME is respected. BASETEN_ROUTER_PORT overrides port 4000;
BASETEN_ROUTER_LOG sets the log level.
EOF
    exit 0
    ;;
  '') ;;
  *) fail "usage: baseten-router [--setup|--help]" ;;
esac

CONFIG="$CONFIG_DIR/config.json"
PORT="${BASETEN_ROUTER_PORT:-4000}"

# A stale listener would leave clients talking to the wrong process.
if lsof -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
  echo "baseten-router: port $PORT is already in use:" >&2
  lsof -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null | while read -r pid; do
    echo "  pid $pid  $(ps -o command= -p "$pid" 2>/dev/null)" >&2
  done
  exit 1
fi

command -v uv >/dev/null 2>&1 || fail "uv is required; install it first."
[ -r "$ROUTER" ] || fail "Router code is missing. Run install.sh install router from your dotfiles checkout."
[ -r "$CONFIG" ] || fail "Config is missing. Run install.sh install router from your dotfiles checkout."

if [ -z "${BASETEN_API_KEY:-}" ]; then
  if [ -r "$CONFIG_DIR/env" ]; then
    # shellcheck source=/dev/null
    . "$CONFIG_DIR/env"
  fi
  if [ -z "${BASETEN_API_KEY:-}" ] && [ -n "${BASETEN_OP_ITEM:-}" ]; then
    command -v op >/dev/null 2>&1 || fail "1Password CLI (op) is required for BASETEN_OP_ITEM."
    BASETEN_API_KEY=$(op item get "$BASETEN_OP_ITEM" --fields password --reveal)
  fi
fi
[ -n "${BASETEN_API_KEY:-}" ] ||
  fail "Set BASETEN_API_KEY or configure BASETEN_OP_ITEM in $CONFIG_DIR/env."

export BASETEN_API_KEY
export BASETEN_ROUTER_PORT="$PORT"
export BASETEN_ROUTER_LOG="${BASETEN_ROUTER_LOG:-INFO}"

exec uv run --python 3.12 --script "$ROUTER"
