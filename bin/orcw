#!/usr/bin/env bash
#
# orcw - launcher for lib/orcw.py, the Orca orchestration wrapper.
#
# This file exists so ~/bin/orcw (a manifest symlink) finds the implementation
# inside the clone regardless of where the clone lives. Prefers `uv run --script` (the
# file carries inline script metadata); falls back to python3.
#
# Usage and exit codes: orcw --help

set -euo pipefail

# /usr/bin/readlink has no -f on macOS, so walk the symlink chain by hand.
self=${BASH_SOURCE[0]}
while [ -L "$self" ]; do
	link=$(readlink "$self")
	case $link in
	/*) self=$link ;;
	*) self=$(dirname "$self")/$link ;;
	esac
done
here=$(cd -P "$(dirname "$self")" && pwd -P)
impl=$here/../lib/orcw.py

if [ ! -f "$impl" ]; then
	echo "orcw: implementation missing at $impl" >&2
	exit 1
fi

if command -v uv >/dev/null 2>&1; then
	exec uv run --quiet --script "$impl" "$@"
fi
exec python3 "$impl" "$@"
