# Denylist: everything outside these patterns is tracked. Patterns cover what
# must never land in this public repo; run `bin/dotfiles-doctor --only scan`
# before pushing, and CI repeats that scan and runs gitleaks over the history.

# Machine-private overlay with its own manifest (private/manifest.tsv)
/private/

# Generated machine state owned by the skills CLI (install timestamps, the
# last-selected agent list, dismissed prompts), not configuration.
/agents/skill-lock.json

# Credentials and machine-local overrides
**/auth.json
**/hosts.yml
**/settings.local.json
**/*credential*
**/*token*
**/*secret*
**/*.pem
**/id_rsa*
**/id_ecdsa*
**/id_ed25519*
**/known_hosts*
**/.netrc

# Environment files
.env
.env.*

# Databases and caches
**/*.sqlite*
**/Cache/
**/CachedData/
__pycache__/
*.pyc
node_modules/

# Histories and editor recovery data can contain private content
**/*history*
**/sessions/
**/logs/
**/swap/
**/undo/
**/view/
**/viminfo

# OS and archive noise
.DS_Store
*.zip
*.tar
*.tar.*
*.dmg
