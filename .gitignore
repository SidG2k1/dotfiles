# ---------------------------------------------------------------------------
# Denylist, second line of defence. These come AFTER the allowlist so the last
# matching pattern wins and they override any `!` re-include above.
# ---------------------------------------------------------------------------

# Generated machine state owned by the skills CLI (install timestamps, the
# last-selected agent list, dismissed prompts), not configuration.
/agents/skill-lock.json

# Credentials and machine-local overrides
**/auth.json
**/hosts.yml
**/settings.local.json
**/*credential*
**/*token*
**/*secret*
**/*.pem
**/id_rsa*
**/id_ecdsa*
**/id_ed25519*
**/known_hosts*
**/.netrc

# Environment files
.env
.env.*
private/

# Databases and caches
**/*.sqlite*
**/Cache/
**/CachedData/

# Histories and editor recovery data can contain private content
**/*history*
**/sessions/
**/logs/
**/swap/
**/undo/
**/view/
**/viminfo

# OS and archive noise
.DS_Store
*.zip
*.tar
*.tar.*
*.dmg
