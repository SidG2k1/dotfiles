# Optional appearance preset; local display overrides may differ.
# The theme lives in config.ghostty so every machine matches; this file holds
# only window appearance.
background-opacity = 0.8
background-opacity-cells = true
background-blur = macos-glass-regular
font-size = 14
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true
macos-titlebar-style = tabs
