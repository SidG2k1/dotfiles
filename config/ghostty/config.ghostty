# Functional settings only. install.sh appends this file as a marker-delimited
# block to ~/.config/ghostty/config, and Ghostty is last-wins, so any key set
# here overrides the same key a machine set above the block. Per-machine
# appearance belongs above the markers or in a display-specific override.

# Nerd Font glyphs for the starship prompt.
font-family = "JetBrainsMono Nerd Font"

# Keep more agent and build output available; allocation is lazy and per pane.
scrollback-limit-bytes = 100000000

# Restore window geometry, tabs, splits, and working directories after quitting.
# Running processes and scrollback are not restored.
window-save-state = always

# Selecting text copies it immediately, so output can be pasted without Cmd+C.
copy-on-select = clipboard

# Prepare interactive SSH sessions: the wrapper installs remote terminfo and
# falls back safely when it cannot.
shell-integration-features = ssh-env,ssh-terminfo

# Notify only when a command ran for at least 10 seconds and Ghostty is unfocused.
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 10s

# Open a fresh Ghostty window from anywhere in macOS.
keybind = global:cmd+alt+g=new_window
