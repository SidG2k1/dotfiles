{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode",
    "mode": "system"
  },
  "animations": true,
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "markdown": "rendered",
    "image_preview": true
  },
  "tabs": {
    "layout": "vertical",
    "indicators": "numbers",
    "enabled": false
  },
  "diffs": {
    "single": false
  },
  "prompt": {
    "image_preview": true
  }
}
