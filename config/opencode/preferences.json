{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "build": {
      "model": "baseten-router/chat"
    },
    "plan": {
      "model": "baseten/moonshotai/Kimi-K3.1-Pro"
    }
  },
  "providers": {
    "baseten-router": {
      "name": "Baseten router",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:4000/v1",
        "apiKey": "local-proxy"
      },
      "models": {
        "chat": {
          "modelID": "baseten-router",
          "name": "Baseten router",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true,
              "effort": [
                "none",
                "low",
                "high",
                "max"
              ]
            }
          },
          "limit": {
            "context": 1000000,
            "output": 32000
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          }
        }
      }
    }
  }
}
