{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "litellm": {
      "name": "LiteLLM (Baseten router)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:4000/v1",
        "apiKey": "local-proxy"
      },
      "models": {
        "baseten-router": {
          "modelID": "baseten-router (litellm)",
          "name": "Baseten router",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 32000
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          }
        }
      }
    }
  }
}
